/**
 * BYC 2026 Results: leaders-only dashboard (UPCMWI Blantyre Youth Ministries).
 * Deploy > New deployment > Web app (Execute as: Me, Who has access: Anyone).
 * Logins live in Project Settings > Script properties, key LEADERS, value like:
 *   {"elie":"a-strong-password","pastor":"another-password"}
 * Only the owner of this project can see those properties.
 */
var SHEET_ID = '1-_Rsw2l53I2nKEDtzAiEQ8_watOpT6FG129YJ-faqm8';
var MAX_FAILS = 5, LOCK_SECONDS = 900, SESSION_SECONDS = 21600;

function doGet() {
  return HtmlService.createHtmlOutput(DASHBOARD_HTML)
    .setTitle('BYC 2026 Results')
    .addMetaTag('viewport', 'width=device-width, initial-scale=1');
}

function leaders_() {
  try { return JSON.parse(PropertiesService.getScriptProperties().getProperty('LEADERS') || '{}'); }
  catch (e) { return {}; }
}

function login(user, pass) {
  user = String(user || '').trim().toLowerCase();
  pass = String(pass || '');
  var cache = CacheService.getScriptCache();
  var failKey = 'fail_' + user;
  var fails = Number(cache.get(failKey) || 0);
  if (fails >= MAX_FAILS) return { ok: false, msg: 'locked' };
  var list = leaders_(), expected = null;
  for (var k in list) if (k.toLowerCase() === user) expected = String(list[k]);
  if (!user || expected === null || expected !== pass) {
    cache.put(failKey, String(fails + 1), LOCK_SECONDS);
    Utilities.sleep(700);
    return { ok: false, msg: 'bad' };
  }
  cache.remove(failKey);
  var token = Utilities.getUuid();
  cache.put('tok_' + token, user, SESSION_SECONDS);
  return { ok: true, token: token, data: aggregate_() };
}

function getData(token) {
  if (!token || !CacheService.getScriptCache().get('tok_' + token)) return { ok: false, msg: 'expired' };
  return { ok: true, data: aggregate_() };
}

function logout(token) {
  if (token) CacheService.getScriptCache().remove('tok_' + token);
  return true;
}

function aggregate_() {
  var values = SpreadsheetApp.openById(SHEET_ID).getSheets()[0].getDataRange().getDisplayValues();
  return summarise_(values[0], values.slice(1));
}

/** Run from the editor to check the numbers without logging in. */
function testSummary() {
  var s = aggregate_();
  Logger.log('DASH_TEST responses=' + s.total + ' declined=' + s.declined + ' converted=' + s.converted +
             ' q1n=' + s.q1.n + ' ratingCols=' + Object.keys(s.ratings).length + ' timeCols=' + Object.keys(s.time).length +
             ' leadersSet=' + Object.keys(leaders_()).length);
}

/* Shared by Apps Script (Code.gs) and the local tests. Plain ES5 so the legacy Apps Script runtime accepts it. */
function summarise_(H, R) {
  function idx(t) { return H.indexOf(t); }
  var out = { total: 0, declined: 0, updated: new Date().toISOString(), counts: {}, multi: {},
              q1: { dist: [0, 0, 0, 0, 0], sum: 0, n: 0 }, ratings: {}, time: {}, text: [], converted: 0 };
  var SINGLE = ['Language', 'Gender', 'Age', 'Q5 Most impactful block', 'Q8 Preferred format for special sessions',
                'Q11 Used conference lodging', 'Q14 Used conference transport'];
  var MULTI = ['Q2 Highlights', 'Q3 Programme blocks attended', 'Q9 Priority topics', 'Q16 Areas of growth'];
  var TEXT = ['Q17 One thing learnt / will practise', 'Q18 One improvement', 'Q19 Other suggestions',
              'Q2 Highlights - other', 'Q9 Priority topics - other', 'Q16 Areas of growth - other'];
  var RATE = /^Q(4|6|10|12|13|15) /, TIME = /^Q7 /;
  var q1Col = -1;
  for (var q = 0; q < H.length; q++) if (String(H[q]).indexOf('Q1 Overall rating') === 0) q1Col = q;   // title changed from (1-10) to (1-5 stars)
  for (var r = 0; r < R.length; r++) {
    var row = R[r];
    var g = function (t) { var i = idx(t); return i < 0 ? '' : String(row[i]).trim(); };
    var consent = g('Consent to take part');
    if (consent === 'No') { out.declined++; continue; }
    if (consent !== 'Yes') continue;
    out.total++;
    var old = g('Rating scale') === '';            // answered on the original 1-10 scale
    if (old) out.converted++;
    var star = function (v) {
      if (!/^\d+$/.test(v)) return null;
      var n = Number(v);
      if (old) n = Math.ceil(n / 2);             // 1-2 -> 1 ... 9-10 -> 5
      return Math.max(1, Math.min(5, n));
    };
    for (var a = 0; a < SINGLE.length; a++) {
      var sv = g(SINGLE[a]); if (!sv) continue;
      var sc = out.counts[SINGLE[a]] = out.counts[SINGLE[a]] || {};
      sc[sv] = (sc[sv] || 0) + 1;
    }
    for (var b = 0; b < MULTI.length; b++) {
      var mc = out.multi[MULTI[b]] = out.multi[MULTI[b]] || {};
      var mv = g(MULTI[b]); if (!mv) continue;
      var parts = mv.split('; ');
      for (var p = 0; p < parts.length; p++) if (parts[p]) mc[parts[p]] = (mc[parts[p]] || 0) + 1;
    }
    var s1 = star(q1Col < 0 ? '' : String(row[q1Col]).trim());
    if (s1) { out.q1.dist[s1 - 1]++; out.q1.sum += s1; out.q1.n++; }
    for (var c = 0; c < H.length; c++) {
      var h = H[c], v = String(row[c]).trim();
      if (RATE.test(h)) {
        var o = out.ratings[h] = out.ratings[h] || { sum: 0, n: 0, na: 0 };
        var s = star(v);
        if (s) { o.sum += s; o.n++; } else if (v) o.na++;
      } else if (TIME.test(h)) {
        var tt = out.time[h] = out.time[h] || {};
        if (v) tt[v] = (tt[v] || 0) + 1;
      }
    }
    for (var d = 0; d < TEXT.length; d++) {
      var tv = g(TEXT[d]);
      if (tv) out.text.push({ q: TEXT[d], a: tv, lang: g('Language'), when: g('Timestamp') });
    }
  }
  out.text.reverse();                             // newest first
  return out;
}

var DASHBOARD_HTML = "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>BYC 2026 Results</title>\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500&display=swap\">\n<style>\n/* Layout: matte-black leaders' console. Login card, then KPI strip and one column of question panels. */\n:root{\n  color-scheme:dark;\n  --ink:#111112; --panel:#18181a; --panel-2:#1f1e21; --line:#2c2b2e; --line-hi:#454348;\n  --text:#f3f2f2; --muted:#a9a6aa; --red:#c8102e; --red-text:#ff4a60;\n  --short:#5b8def; --right:#2aa68f; --long:#c97a22;   /* validated on #18181a */\n  --f-display:\"Helvetica Neue\",Helvetica,Arial,sans-serif;\n  --f-body:\"Poppins\",\"Century Gothic\",\"Trebuchet MS\",sans-serif;\n}\n*{box-sizing:border-box}\n[hidden]{display:none!important}\nbody{margin:0;background:var(--ink);color:var(--text);font-family:var(--f-body);font-size:15px;line-height:1.5;-webkit-font-smoothing:antialiased}\n.wrap{max-width:1040px;margin:0 auto;padding:24px max(16px,env(safe-area-inset-left,0px)) 60px}\nbutton,input{font:inherit;color:inherit}\n:focus-visible{outline:2px solid var(--red-text);outline-offset:2px}\n.brand{display:flex;align-items:center;gap:16px;flex-wrap:wrap}\n.brand img{width:120px}\n.eyebrow{font-size:.75rem;letter-spacing:.3em;color:var(--red-text);text-transform:uppercase}\nh1{font-family:var(--f-display);font-weight:700;font-size:clamp(1.6rem,4vw,2.3rem);margin:.15rem 0 0;line-height:1.05;text-transform:uppercase}\nh1 span{color:var(--red)}\n.sub{color:var(--muted);font-weight:300;font-size:.88rem}\n\n/* login */\n.login{max-width:380px;margin:12vh auto 0;background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:28px;display:grid;gap:14px}\n.login img{width:150px;justify-self:center}\n.login h1{text-align:center;font-size:1.5rem}\n.login label{display:grid;gap:6px;font-size:.85rem;color:var(--muted)}\n.login input{background:#0c0c0d;border:1px solid var(--line-hi);border-radius:9px;padding:11px 13px}\n.btn{background:var(--red);border:1px solid var(--red);color:#fff;border-radius:999px;padding:11px 22px;cursor:pointer;font-weight:500;letter-spacing:.08em;text-transform:uppercase;font-size:.82rem}\n.btn.ghost{background:none;border-color:var(--line-hi);color:var(--text)}\n.btn:disabled{opacity:.55;cursor:wait}\n.msg{color:var(--red-text);font-size:.85rem;min-height:1.2em}\n\n/* dashboard */\n.top{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;flex-wrap:wrap;border-bottom:1px solid var(--line);padding-bottom:18px}\n.actions{display:flex;gap:10px;align-items:center;flex-wrap:wrap}\n.kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin:22px 0}\n.kpi{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:16px}\n.kpi .v{font-family:var(--f-display);font-weight:700;font-size:2rem;line-height:1.1;font-variant-numeric:tabular-nums}\n.kpi .v small{font-size:1rem;color:var(--red-text)}\n.kpi .l{color:var(--muted);font-size:.8rem;font-weight:300}\n@media (max-width:700px){.kpis{grid-template-columns:repeat(2,minmax(0,1fr))}}\n.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}\n@media (max-width:760px){.grid{grid-template-columns:1fr}}\n.panel{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:18px;min-width:0}\n.panel.wide{grid-column:1/-1}\n.panel h2{font-size:.98rem;font-weight:500;margin:0 0 2px}\n.panel h2 b{color:var(--red-text);font-family:var(--f-display);margin-right:6px}\n.panel .note{color:var(--muted);font-size:.78rem;font-weight:300;margin:0 0 12px}\n.sec-title{font-family:var(--f-display);font-weight:700;text-transform:uppercase;letter-spacing:.04em;font-size:1rem;margin:28px 0 10px;color:var(--muted)}\n.sec-title span{color:var(--red-text);margin-right:8px}\n\n/* bar list */\n.bars{display:grid;gap:9px}\n.bar{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:4px 10px;align-items:center}\n.bar .lab{font-size:.84rem;min-width:0;overflow-wrap:anywhere}\n.bar .val{font-size:.8rem;color:var(--muted);font-variant-numeric:tabular-nums;white-space:nowrap}\n.bar .track{grid-column:1/-1;height:10px;background:var(--panel-2);border-radius:5px;overflow:hidden}\n.bar .fill{height:100%;background:var(--red);border-radius:0 4px 4px 0;min-width:2px}\n.bar:hover .fill{filter:brightness(1.18)}\n.empty{color:var(--muted);font-size:.84rem;font-weight:300;font-style:italic}\n\n/* Q4 heat table */\n.tbl-wrap{overflow-x:auto}\ntable.heat{border-collapse:separate;border-spacing:3px;width:100%;min-width:520px;font-variant-numeric:tabular-nums}\n.heat th{font-weight:400;font-size:.76rem;color:var(--muted);text-align:center;padding:4px}\n.heat th.row{text-align:left;color:var(--text);font-size:.84rem;white-space:nowrap}\n.heat td{text-align:center;border-radius:6px;padding:10px 4px;font-size:.88rem}\n.heat td small{display:block;font-size:.68rem;opacity:.75}\n\n/* Q7 stacked */\n.legend{display:flex;gap:16px;flex-wrap:wrap;font-size:.78rem;color:var(--muted);margin-bottom:12px}\n.legend i{display:inline-block;width:10px;height:10px;border-radius:2px;margin-right:6px;vertical-align:-1px}\n.stack{display:flex;height:14px;border-radius:5px;overflow:hidden;gap:2px;background:var(--panel-2)}\n.stack span{height:100%}\n\n/* comments */\n.chips{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px}\n.chip{border:1px solid var(--line-hi);background:none;border-radius:999px;padding:5px 12px;font-size:.78rem;cursor:pointer;color:var(--muted)}\n.chip[aria-pressed=\"true\"]{background:var(--red);border-color:var(--red);color:#fff}\n.comments{display:grid;gap:10px;max-height:520px;overflow:auto;padding-right:4px}\n.c{border-left:3px solid var(--line-hi);padding:6px 12px;background:var(--panel-2);border-radius:0 8px 8px 0}\n.c p{margin:0;font-size:.88rem}\n.c .meta{font-size:.72rem;color:var(--muted);font-weight:300}\n#tip{position:fixed;pointer-events:none;background:#000;border:1px solid var(--line-hi);border-radius:8px;padding:6px 10px;font-size:.78rem;z-index:50;max-width:260px}\n.footer{color:var(--muted);font-size:.75rem;font-weight:300;margin-top:30px;text-align:center}\n</style>\n</head>\n<body>\n<div class=\"wrap\">\n  <form class=\"login\" id=\"login\" autocomplete=\"on\">\n    <img src=\"data:image/png;base64,\" alt=\"BTC 26 · Blantyre Youth Conference 26\">\n    <div style=\"text-align:center\"><div class=\"eyebrow\">Leaders only</div><h1>BYC 2026 <span>Results</span></h1></div>\n    <label>Username<input id=\"user\" name=\"username\" autocomplete=\"username\" required></label>\n    <label>Password<input id=\"pass\" name=\"password\" type=\"password\" autocomplete=\"current-password\" required></label>\n    <div class=\"msg\" id=\"msg\" role=\"alert\"></div>\n    <button class=\"btn\" id=\"go\" type=\"submit\">Sign in</button>\n  </form>\n\n  <div id=\"dash\" hidden>\n    <div class=\"top\">\n      <div class=\"brand\"><img src=\"data:image/png;base64,\" alt=\"\">\n        <div><div class=\"eyebrow\">UPCMWI · Blantyre Youth Ministries</div><h1>BYC 2026 <span>Results</span></h1>\n        <div class=\"sub\" id=\"stamp\"></div></div></div>\n      <div class=\"actions\"><button class=\"btn ghost\" id=\"refresh\" type=\"button\">Refresh</button><button class=\"btn ghost\" id=\"out\" type=\"button\">Sign out</button></div>\n    </div>\n    <div class=\"kpis\" id=\"kpis\"></div>\n    <div id=\"body\"></div>\n    <div class=\"footer\">Updates every minute · Star ratings: 1 = Poor, 5 = Excellent · N/A and \"did not attend\" are left out of averages</div>\n  </div>\n</div>\n<div id=\"tip\" hidden></div>\n\n<script>\nconst $ = s => document.querySelector(s);\nconst esc = s => String(s).replace(/[&<>\"]/g, c => ({\"&\":\"&amp;\",\"<\":\"&lt;\",\">\":\"&gt;\",'\"':\"&quot;\"}[c]));\nlet token = null, timer = null, data = null, commentFilter = \"All\";\nconst run = () => google.script.run;\n\n/* ---------- login ---------- */\n$(\"#login\").addEventListener(\"submit\", e => {\n  e.preventDefault();\n  const go = $(\"#go\"); go.disabled = true; $(\"#msg\").textContent = \"\";\n  run().withSuccessHandler(res => {\n    go.disabled = false;\n    if (!res.ok){\n      $(\"#msg\").textContent = res.msg === \"locked\" ? \"Too many wrong attempts. Wait 15 minutes, then try again.\" : \"That username and password don't match. Check them and try again.\";\n      return;\n    }\n    token = res.token; $(\"#pass\").value = \"\";\n    $(\"#login\").hidden = true; $(\"#dash\").hidden = false;\n    show(res.data); timer = setInterval(refresh, 60000);\n  }).withFailureHandler(err => { go.disabled = false; $(\"#msg\").textContent = \"Couldn't reach the results. Check your connection and try again.\"; })\n    .login($(\"#user\").value, $(\"#pass\").value);\n});\nfunction refresh(){\n  $(\"#refresh\").disabled = true;\n  run().withSuccessHandler(res => {\n    $(\"#refresh\").disabled = false;\n    if (!res.ok){ signOut(\"Your session ended. Sign in again.\"); return; }\n    show(res.data);\n  }).withFailureHandler(() => { $(\"#refresh\").disabled = false; }).getData(token);\n}\nfunction signOut(msg){\n  clearInterval(timer); if (token) run().logout(token); token = null;\n  $(\"#dash\").hidden = true; $(\"#login\").hidden = false; $(\"#msg\").textContent = msg || \"\";\n}\n$(\"#refresh\").addEventListener(\"click\", refresh);\n$(\"#out\").addEventListener(\"click\", () => signOut());\n\n/* ---------- chart pieces ---------- */\nconst pct = (n, t) => t ? Math.round(n / t * 100) : 0;\nfunction bars(obj, total, order){\n  let entries = Object.entries(obj || {});\n  if (order) entries = order.map(k => [k, (obj||{})[k] || 0]); else entries.sort((a,b) => b[1] - a[1]);\n  if (!entries.length || !total) return `<div class=\"empty\">No answers yet.</div>`;\n  const max = Math.max(...entries.map(e => e[1]), 1);\n  return `<div class=\"bars\">` + entries.map(([k,v]) =>\n    `<div class=\"bar\" data-tip=\"${esc(k)}: ${v} of ${total} (${pct(v,total)}%)\"><span class=\"lab\">${esc(k)}</span><span class=\"val\">${v} · ${pct(v,total)}%</span><div class=\"track\"><div class=\"fill\" style=\"width:${v/max*100}%\"></div></div></div>`).join(\"\") + `</div>`;\n}\nfunction rateBars(prefix){\n  const items = Object.entries(data.ratings).filter(([h]) => h.startsWith(prefix));\n  if (!items.some(([,o]) => o.n)) return `<div class=\"empty\">No ratings yet.</div>`;\n  return `<div class=\"bars\">` + items.map(([h,o]) => {\n    const avg = o.n ? o.sum / o.n : 0, lab = h.slice(prefix.length);\n    return `<div class=\"bar\" data-tip=\"${esc(lab)}: ${avg.toFixed(2)} ★ from ${o.n} rating${o.n===1?\"\":\"s\"}${o.na?`, ${o.na} N/A`:\"\"}\"><span class=\"lab\">${esc(lab)}</span><span class=\"val\">${o.n ? avg.toFixed(1)+\" ★\" : \"—\"} · n=${o.n}</span><div class=\"track\"><div class=\"fill\" style=\"width:${avg/5*100}%\"></div></div></div>`;\n  }).join(\"\") + `</div>`;\n}\nfunction heat(){\n  const svcs = [\"Friday PM\",\"Saturday AM\",\"Saturday MID\",\"Saturday PM\",\"Sunday AM\"], crit = [\"Relevance\",\"Impact\",\"Worship\",\"Timekeeping\"];\n  const names = {Relevance:\"Message relevance\", Impact:\"What I learnt\", Worship:\"Worship & engagement\", Timekeeping:\"Timekeeping\"};\n  let h = `<div class=\"tbl-wrap\"><table class=\"heat\"><thead><tr><th></th>${crit.map(c=>`<th>${names[c]}</th>`).join(\"\")}</tr></thead><tbody>`;\n  for (const s of svcs){\n    h += `<tr><th class=\"row\" scope=\"row\">${s}</th>`;\n    for (const c of crit){\n      const o = data.ratings[`Q4 ${s} — ${c}`] || {sum:0,n:0,na:0};\n      const avg = o.n ? o.sum / o.n : 0;\n      const a = o.n ? (0.12 + (avg - 1) / 4 * 0.78) : 0;                 // one-hue ramp: darker red = higher score\n      h += `<td style=\"background:rgba(200,16,46,${a.toFixed(2)});${avg>=3.4?\"color:#fff\":\"\"}\" data-tip=\"${s} · ${names[c]}: ${o.n?avg.toFixed(2)+\" ★ from \"+o.n:\"no ratings\"}\">${o.n?avg.toFixed(1):\"—\"}<small>n=${o.n}</small></td>`;\n    }\n    h += `</tr>`;\n  }\n  return h + `</tbody></table></div>`;\n}\nfunction stacks(){\n  const cols = [[\"Too short\",\"var(--short)\"],[\"Just right\",\"var(--right)\"],[\"Too long\",\"var(--long)\"]];\n  const rows = Object.entries(data.time);\n  let h = `<div class=\"legend\">${cols.map(([k,c])=>`<span><i style=\"background:${c}\"></i>${k}</span>`).join(\"\")}</div><div class=\"bars\">`;\n  for (const [k, o] of rows){\n    const t = cols.reduce((s,[c]) => s + (o[c]||0), 0);\n    const lab = k.replace(\"Q7 Time allocation: \",\"\");\n    h += `<div class=\"bar\"><span class=\"lab\">${esc(lab)}</span><span class=\"val\">${t ? cols.map(([c])=>pct(o[c]||0,t)+\"%\").join(\" / \") : \"—\"}</span><div class=\"stack\" style=\"grid-column:1/-1\">` +\n      (t ? cols.map(([c,col]) => o[c] ? `<span style=\"width:${o[c]/t*100}%;background:${col}\" data-tip=\"${esc(lab)} · ${c}: ${o[c]} (${pct(o[c],t)}%)\"></span>` : \"\").join(\"\") : \"\") + `</div></div>`;\n  }\n  return h + `</div>`;\n}\nfunction comments(){\n  const qs = [\"All\", ...new Set(data.text.map(t => t.q))];\n  const list = data.text.filter(t => commentFilter === \"All\" || t.q === commentFilter);\n  return `<div class=\"chips\">${qs.map(q=>`<button class=\"chip\" type=\"button\" data-cf=\"${esc(q)}\" aria-pressed=\"${q===commentFilter}\">${esc(q.replace(/ - other$/,\" (other)\"))}</button>`).join(\"\")}</div>` +\n    (list.length ? `<div class=\"comments\">${list.map(t=>`<div class=\"c\"><div class=\"meta\">${esc(t.q)} · ${esc(t.lang)}${t.when?` · ${esc(t.when)}`:\"\"}</div><p>${esc(t.a)}</p></div>`).join(\"\")}</div>` : `<div class=\"empty\">No written answers yet.</div>`);\n}\nconst panel = (title, note, inner, wide) => `<section class=\"panel ${wide?\"wide\":\"\"}\"><h2>${title}</h2>${note?`<p class=\"note\">${note}</p>`:\"\"}${inner}</section>`;\nconst sec = (k, t) => `<div class=\"sec-title\"><span>${k}</span>${t}</div>`;\n\n/* ---------- page ---------- */\nfunction show(d){\n  data = d;\n  const T = d.total, avg = d.q1.n ? d.q1.sum / d.q1.n : 0, L = d.counts.Language || {};\n  $(\"#stamp\").textContent = `Last updated ${new Date(d.updated).toLocaleString()}${d.converted ? ` · ${d.converted} early response${d.converted===1?\"\":\"s\"} converted from the 1–10 scale` : \"\"}`;\n  $(\"#kpis\").innerHTML = [\n    [T, \"Responses\"],\n    [avg ? `${avg.toFixed(1)}<small> ★</small>` : \"—\", \"Overall rating (Q1)\"],\n    [`${L.English||0}<small> / ${L.Chichewa||0}</small>`, \"English / Chichewa\"],\n    [d.declined, \"Chose not to take part\"],\n  ].map(([v,l]) => `<div class=\"kpi\"><div class=\"v\">${v}</div><div class=\"l\">${l}</div></div>`).join(\"\");\n  const c = d.counts, m = d.multi, n = x => Object.values(x||{}).reduce((a,b)=>a+b,0);\n  $(\"#body\").innerHTML =\n    sec(\"A–B\", \"Who answered & overall\") + `<div class=\"grid\">` +\n      panel(\"Gender\", \"\", bars(c.Gender, n(c.Gender), [\"Male\",\"Female\"])) +\n      panel(\"Age\", \"\", bars(c.Age, n(c.Age), [\"12-17\",\"18-24\",\"25-30\",\"31-35\",\"36-40\",\"Above 40\"])) +\n      panel(\"<b>Q1</b>Overall rating\", `Average ${avg ? avg.toFixed(2) : \"—\"} ★ from ${d.q1.n}`, bars({\"★★★★★ 5\":d.q1.dist[4],\"★★★★ 4\":d.q1.dist[3],\"★★★ 3\":d.q1.dist[2],\"★★ 2\":d.q1.dist[1],\"★ 1\":d.q1.dist[0]}, d.q1.n, [\"★★★★★ 5\",\"★★★★ 4\",\"★★★ 3\",\"★★ 2\",\"★ 1\"])) +\n      panel(\"<b>Q2</b>Highlights\", \"Share of respondents who ticked each (up to 5 each)\", bars(m[\"Q2 Highlights\"], T)) +\n    `</div>` +\n    sec(\"C\", \"Services & spiritual experience\") + `<div class=\"grid\">` +\n      panel(\"<b>Q3</b>Attendance\", \"Share of respondents at each block\", bars(m[\"Q3 Programme blocks attended\"], T, [\"Friday PM\",\"Saturday AM\",\"Saturday MID\",\"Saturday PM\",\"Sunday AM\"])) +\n      panel(\"<b>Q5</b>Most impactful\", \"\", bars(c[\"Q5 Most impactful block\"], n(c[\"Q5 Most impactful block\"]))) +\n      panel(\"<b>Q4</b>Service ratings\", \"Average stars per service and criterion · darker = higher · n = number who rated\", heat(), true) +\n    `</div>` +\n    sec(\"D\", \"Special sessions & timing\") + `<div class=\"grid\">` +\n      panel(\"<b>Q6</b>Saturday afternoon activities\", \"Average stars\", rateBars(\"Q6 Sat afternoon: \")) +\n      panel(\"<b>Q8</b>Preferred session format\", \"\", bars(c[\"Q8 Preferred format for special sessions\"], n(c[\"Q8 Preferred format for special sessions\"]))) +\n      panel(\"<b>Q7</b>Time allocation\", \"Split of answers per programme (did not attend left out)\", stacks(), true) +\n      panel(\"<b>Q9</b>Topics for next time\", \"Share of respondents who picked each\", bars(m[\"Q9 Priority topics\"], T), true) +\n    `</div>` +\n    sec(\"E–F\", \"Organisation, lodging, food & transport\") + `<div class=\"grid\">` +\n      panel(\"<b>Q10</b>Organisation\", \"Average stars\", rateBars(\"Q10 Organisation: \")) +\n      panel(\"<b>Q13</b>Catering\", \"Average stars\", rateBars(\"Q13 Catering: \")) +\n      panel(\"<b>Q11–12</b>Lodging\", `${(c[\"Q11 Used conference lodging\"]||{}).Yes||0} used conference lodging · average stars`, rateBars(\"Q12 Accommodation: \")) +\n      panel(\"<b>Q14–15</b>Transport\", `${(c[\"Q14 Used conference transport\"]||{}).Yes||0} used conference transport · average stars`, rateBars(\"Q15 Transport: \")) +\n    `</div>` +\n    sec(\"G\", \"Growth & what people said\") + `<div class=\"grid\">` +\n      panel(\"<b>Q16</b>Areas of growth\", \"Share of respondents who picked each\", bars(m[\"Q16 Areas of growth\"], T), true) +\n      panel(\"Written answers\", \"Q17–19 and every “Other” answer, newest first\", comments(), true) +\n    `</div>`;\n}\ndocument.addEventListener(\"click\", e => {\n  const b = e.target.closest(\"[data-cf]\"); if (!b) return;\n  commentFilter = b.dataset.cf; const p = b.closest(\".panel\"); p.querySelector(\".chips\").parentNode.innerHTML = p.querySelector(\"h2\").outerHTML + p.querySelector(\".note\").outerHTML + comments();\n});\n/* hover tooltip for every bar, segment and cell */\nconst tip = $(\"#tip\");\ndocument.addEventListener(\"mousemove\", e => {\n  const t = e.target.closest(\"[data-tip]\");\n  if (!t){ tip.hidden = true; return; }\n  tip.textContent = t.dataset.tip; tip.hidden = false;\n  tip.style.left = Math.min(e.clientX + 14, innerWidth - tip.offsetWidth - 8) + \"px\";\n  tip.style.top = (e.clientY + 16) + \"px\";\n});\n</script>\n</body>\n</html>\n";
